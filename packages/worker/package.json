{
  "name": "@mc-motd/worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker backend for Minecraft MOTD Discord bot",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute mc_motd_db --local --file=./src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute mc_motd_db --remote --file=./src/db/schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
